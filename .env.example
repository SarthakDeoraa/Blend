# Supabase Configuration
# Get these from your Supabase Dashboard: Settings -> API

# Public URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon/publishable key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (keep secret, server-side only for background tasks/admin scripts)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
